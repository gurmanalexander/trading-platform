{
  "name": "tvx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config journal/vite.config.ts && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev:journal": "vite --config journal/vite.config.ts",
    "build:journal": "vite build --config journal/vite.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "mock:exchange": "node scripts/mock-exchange.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "lightweight-charts": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "lucide-static": "^1.72.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
