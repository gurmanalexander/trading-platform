{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [
      "vite/client",
      "chrome"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "journal/src/**/*.ts",
    "journal/src/**/*.vue",
    "extension/src/**/*.ts",
    "extension/src/**/*.vue",
    "tests/**/*.ts",
    "vite.config.ts",
    "journal/vite.config.ts"
  ]
}
